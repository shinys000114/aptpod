[Unit]
Description=aptpod apt repository and mirror server
Documentation=https://github.com/shinys000114/aptpod
Wants=network-online.target
After=network-online.target

[Service]
User=aptpod
Group=aptpod
ExecStart=/usr/bin/aptpod-server --config /etc/aptpod/server.toml
# Re-reads config_file (publishes and mirrors declared in a file).
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=10s
# No StateDirectory=: systemd would bind-mount /var/lib/aptpod into the
# service's namespace, and hard links from the store into publish roots on
# the same filesystem would fail (packages copied, stored twice). The
# postinst creates the directory.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
# ProtectSystem=full keeps /usr, /boot and /etc read-only; publish roots
# elsewhere (/srv, /var/www, ...) stay writable for the aptpod user.

[Install]
WantedBy=multi-user.target
